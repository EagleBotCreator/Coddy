# Reference only. This file is NOT loaded automatically.
# Set these as environment variables in PowerShell before running Coddy.
OPENAI_API_KEY=YOUR_KEY_HERE
CODDY_VAULT_PATH=C:\Users\YOUR_USERNAME\Documents\Coddy Memory
CODDY_MODEL=gpt-5.4-mini
CODDY_AUTO_SUGGEST=false
# Optional: name of a voice installed in Windows. Use `coddy voices` to list.
CODDY_VOICE=
# Optional: CODDY_DATA_PATH=C:\Users\YOUR_USERNAME\.coddy
